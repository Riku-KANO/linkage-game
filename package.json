{
  "name": "ashikumi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "アシクミ — リンク機構歩行機械ゲーム",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "node scripts/verify.mjs",
    "deploy": "node scripts/deps.mjs check && node scripts/verify.mjs && cf deploy",
    "deploy:dry": "cf deploy --dry-run",
    "deps:check": "node scripts/deps.mjs check",
    "deps:update": "node scripts/deps.mjs update",
    "serve:dist": "node scripts/serve-dist.mjs",
    "e2e": "vite build --logLevel warn && playwright test",
    "calibrate": "vitest run src/game/calibrate.test.ts --silent=false",
    "models": "node scripts/models.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.2.0",
    "lz-string": "^1.5.0",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-67fa336fd",
    "@playwright/test": "^1.64.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cf": "1.0.0-beta.17",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
